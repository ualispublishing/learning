{"answer_key":[{"answer":"اس کے پاس کاغذی رسید نہیں تھی۔","explanation":"","id":"a1","question_id":"q1"},{"answer":"چیز استعمال نہ ہوئی ہو، اصل ٹیگ لگا ہو اور خریداری کا ثبوت موجود ہو۔","explanation":"","id":"a2","question_id":"q2"},{"answer":"اس نے پوچھا کہ کیا دوسرا ثبوت قبول ہو سکتا ہے اور پھر ڈیجیٹل رسید دکھائی۔","explanation":"","id":"a3","question_id":"q3"},{"answer":"کیونکہ ڈیجیٹل رسید اور آرڈر نمبر سے خریداری کی تفصیلات تصدیق ہو گئیں۔","explanation":"","id":"a4","question_id":"q4"},{"answer":"خاص اور واضح شرطیں جو واپسی کے لیے مقرر ہوں۔","explanation":"","id":"a5","question_id":"q5"},{"answer":"درخواست قبول نہ ہونا یا رد کر دیا جانا۔","explanation":"","id":"a6","question_id":"q6"},{"answer":"ڈیجیٹل رسید اور آرڈر نمبر سے خریداری ثابت ہونے کے بعد کی حالت۔","explanation":"","id":"a7","question_id":"q7"},{"answer":"مخصوص","explanation":"","id":"a8","question_id":"q8"},{"answer":"مسترد","explanation":"","id":"a9","question_id":"q9"},{"answer":"واپسی کی مخصوص شرطیں پڑھیں اور رسید یا قابلِ تصدیق خریداری کا ثبوت ساتھ رکھیں۔","explanation":"","id":"a10","question_id":"q10"}],"cefr":"A2","complexity_profile":{"clause_count":null,"connective_diversity":null,"coordination_count":null,"inference_depth":"local_to_two_sentence","lexical_diversity":null,"mean_sentence_length":null,"median_sentence_length":null,"morphology_notes":"A2 generation-stage draft; contemporary standard Urdu with comparisons, practical conditions, and controlled problem-solution links.","multiword_expression_count":null,"reference_chain_max_distance":null,"subordination_count":null},"difficulty_notes_internal":"A2 Unit 04 generation draft: shopping comparison, price/condition problems, returns, evidence, and practical resolution.","discourse_targets":[{"description":"follow a return request from missing proof to an accepted alternative","id":"ur-a2-u04-return-proof","role":"new"}],"domains":["personal","public"],"estimated_known_token_coverage":0,"genre":"problem-solution narrative","grammar_targets":[{"description":"express required conditions with ضروری / ہو","id":"ur-a2-return-condition","role":"new"},{"description":"ask whether an alternative can be accepted","id":"ur-a2-alternative-proof","role":"review"}],"id":"ur-a2-u04-p02","language":"ur","new_lexical_targets":[{"beyond_base":false,"context_strategy":["category_relation"],"exposures_in_text":3,"first_introduced":true,"form":"مخصوص","id":"ur-rank-0765","intended_sense":"specific; particular","lemma":"مخصوص","part_of_speech":"adjective","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":765,"variety":"contemporary standard Urdu"},{"beyond_base":false,"context_strategy":["scenario_resolution"],"exposures_in_text":3,"first_introduced":true,"form":"مسترد","id":"ur-rank-0715","intended_sense":"rejected; refused; not accepted","lemma":"مسترد","part_of_speech":"adjective","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":715,"variety":"contemporary standard Urdu"}],"paired_text_group":null,"passage_type":"reinforcement","prerequisites":["Urdu A1 generation corpus","Urdu A2 Units 1-3"],"quality":{"answer_key_check":"pending","coverage_check":"pending","fact_check":"not_required","linguistic_review":"pending","notes":["High-quality Urdu A2 generation-stage draft; formal linguistic, pedagogical, lexical-coverage, answer-key, and schema audits are deferred to the designated final multi-pass review phase.","Written independently in contemporary standard Urdu for the A2 shopping-comparison-and-problems roadmap; not translated from the Arabic or French corpora.","The deliberate learner-facing senses introduced in this unit were independently checked against the project Urdu lexicon and Rekhta Dictionary on 2026-08-24; persistent bounded evidence is stored in reading/audit/urdu_a2_u04_lexical_sense_check_2026-08-24.json.","Pre-canonical Urdu A2 Unit 4 reader-first quality pass completed 2026-08-24 for naturalness, target-sense clarity, answer grounding, operational grammar, and fluency new-word policy; formal release gates remain pending."],"pedagogical_review":"pending","schema_check":"pending","status":"draft"},"questions":[{"answer_id":"a1","id":"q1","prompt":"علی کو جیکٹ واپس کرنے میں شروع میں کیا رکاوٹ آئی؟","type":"gist"},{"answer_id":"a2","id":"q2","prompt":"بورڈ کے مطابق واپسی کی تین شرطیں کیا تھیں؟","type":"literal_detail"},{"answer_id":"a3","id":"q3","prompt":"کاغذی رسید نہ ہونے کے بعد علی نے کیا کیا؟","type":"sequence"},{"answer_id":"a4","id":"q4","prompt":"ملازم نے آخر میں درخواست کیوں قبول کی؟","type":"inference"},{"answer_id":"a5","id":"q5","prompt":"«مخصوص شرطیں» سے کیا مراد ہے؟","target_ids":["ur-rank-0765"],"type":"vocabulary_in_context"},{"answer_id":"a6","id":"q6","prompt":"«درخواست مسترد ہو سکتی ہے» میں «مسترد» کا کیا مطلب ہے؟","target_ids":["ur-rank-0715"],"type":"vocabulary_in_context"},{"answer_id":"a7","id":"q7","prompt":"«اب درخواست مسترد کرنے کی وجہ نہیں ہے» میں «اب» کس تبدیلی کے بعد کی حالت بتاتا ہے؟","type":"reference_resolution"},{"answer_id":"a8","id":"q8","prompt":"درست لفظ چنیں: یہ رعایت صرف _____ اشیا کے لیے ہے۔","target_ids":["ur-rank-0765"],"type":"grammar_choice"},{"answer_id":"a9","id":"q9","prompt":"خالی جگہ پُر کریں: ضروری ثبوت نہ ہو تو واپسی کی درخواست _____ ہو سکتی ہے۔","target_ids":["ur-rank-0715"],"type":"cloze_transfer"},{"answer_id":"a10","id":"q10","prompt":"علی کے تجربے سے واپسی سے پہلے کیا عملی سبق ملتا ہے؟","type":"paraphrase"}],"reader_tags":["unit_role:reinforcement","generation_batch","a2"],"review_lexical_targets":[{"form":"درخواست","id":"ur-rank-0638","representation":"running_text","review_stage":"R2"},{"form":"تفصیلات","id":"ur-rank-0656","representation":"running_text","review_stage":"R2"}],"revision":1,"sentence_count":12,"sequence":20,"speed_training":{"benchmark_eligible":false,"comprehension_gate":0.8,"new_word_policy":"controlled","notes":"A2 generation-stage passage; formal fluency/coverage decision deferred to final audit.","timed":false},"text":"علی نے سردیوں کے لیے ایک جیکٹ خریدی، لیکن گھر پہنچ کر اسے محسوس ہوا کہ آستین اس کے لیے بہت لمبی ہیں۔ اگلے دن وہ جیکٹ واپس کرنے دکان گیا۔ کاؤنٹر پر ایک چھوٹا بورڈ لگا تھا جس میں لکھا تھا کہ واپسی کے لیے چند مخصوص شرطیں پوری کرنا ضروری ہیں۔ کپڑے استعمال نہ کیے گئے ہوں، اصل ٹیگ لگا ہو اور خریداری کا ثبوت موجود ہو۔ علی کے پاس جیکٹ اور ٹیگ دونوں تھے، مگر کاغذی رسید نہیں تھی۔ ملازم نے بتایا کہ بغیر ثبوت کے درخواست مسترد ہو سکتی ہے۔ علی کو لگا کہ اس کی واپسی کی درخواست فوراً مسترد کر دی جائے گی، لیکن اس نے پوچھا کہ کیا کوئی دوسرا ثبوت قبول ہو سکتا ہے۔ ملازم نے کہا کہ مخصوص صورت میں موبائل پر موجود ڈیجیٹل رسید بھی دیکھی جا سکتی ہے۔ علی نے بینک کے پیغام کے ساتھ دکان کی ای میل کھولی، جہاں آرڈر نمبر موجود تھا۔ ملازم نے تفصیلات ملائیں اور کہا کہ اب درخواست مسترد کرنے کی وجہ نہیں ہے۔ علی نے اسی قیمت کی چھوٹی جیکٹ منتخب کر لی۔ جاتے ہوئے اس نے بورڈ دوبارہ پڑھا تاکہ اسے یاد رہے کہ مخصوص شرطوں کو پہلے دیکھ لینے سے واپسی کا کام آسان ہو جاتا ہے۔","title":"جیکٹ کی واپسی","topics":["return","conditions","proof of purchase"],"unit":4,"word_count":207}