{"answer_key":[{"answer":"رضاکاروں نے پارک میں کام کیا اور اس کے عملی نتیجے کا جائزہ لیا گیا۔","explanation":"","id":"a1","question_id":"q1"},{"answer":"کاغذ اور پلاسٹک جمع کرنے اور خشک شاخیں ہٹانے میں۔","explanation":"","id":"a2","question_id":"q2"},{"answer":"جمع کیے گئے تھیلوں کی تعداد نوٹ کی گئی اور راستوں کی حالت دوبارہ دیکھی گئی۔","explanation":"","id":"a3","question_id":"q3"},{"answer":"کیونکہ لوگوں کی شرکت اور بعد میں صفائی برقرار رہنا بھی اہم ہے۔","explanation":"","id":"a4","question_id":"q4"},{"answer":"کسی کام یا سرگرمی کے بعد سامنے آنے والا حاصل یا اثر۔","explanation":"","id":"a5","question_id":"q5"},{"answer":"کام میں فعال طور پر لگے رہے اور حصہ لیتے رہے۔","explanation":"","id":"a6","question_id":"q6"},{"answer":"تو","explanation":"","id":"a7","question_id":"q7"},{"answer":"رضاکاروں کی اس گفتگو کی طرف جس میں آنے والوں سے مزید توجہ والی جگہ پوچھی گئی۔","explanation":"","id":"a8","question_id":"q8"},{"answer":"سرگرم","explanation":"","id":"a9","question_id":"q9"},{"answer":"فوری نتیجہ مرکزی راستے اور میدان کی بہتری تھی؛ بعد میں دیکھا جائے گا کہ صفائی برقرار رہتی ہے یا نہیں۔","explanation":"","id":"a10","question_id":"q10"}],"cefr":"A2","complexity_profile":{"clause_count":null,"connective_diversity":null,"coordination_count":null,"inference_depth":"local_to_two_sentence","lexical_diversity":null,"mean_sentence_length":null,"median_sentence_length":null,"morphology_notes":"A2 generation-stage draft; contemporary standard Urdu with simple local-reporting, announcement, reaction, and cause-effect structures.","multiword_expression_count":null,"reference_chain_max_distance":null,"subordination_count":null},"difficulty_notes_internal":"A2 Unit 07 generation draft: community events, announcements, simple local news, outcomes, administration responses, and careful separation of facts from reactions.","discourse_targets":[{"id":"ur-a2-u07-discourse-p03","role":"new","description":"follow and distinguish event information, outcomes, announcements, and community reactions"}],"domains":["public","community"],"estimated_known_token_coverage":0,"genre":"brief news report","grammar_targets":[{"id":"ur-a2-u07-link-p03","role":"new","description":"controlled cause, contrast, condition, and reporting links for community information"}],"id":"ur-a2-u07-p03","language":"ur","new_lexical_targets":[{"beyond_base":false,"context_strategy":["scenario_resolution"],"exposures_in_text":4,"first_introduced":true,"form":"نتیجہ","id":"ur-rank-0622","intended_sense":"result; outcome of an action or event","lemma":"نتیجہ","part_of_speech":"noun","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":622,"variety":"contemporary standard Urdu"},{"beyond_base":false,"context_strategy":["scenario_resolution"],"exposures_in_text":6,"first_introduced":true,"form":"سرگرم","id":"ur-rank-0646","intended_sense":"active; engaged and taking part in an activity","lemma":"سرگرم","part_of_speech":"adjective","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":646,"variety":"contemporary standard Urdu"}],"paired_text_group":null,"passage_type":"interleaved","prerequisites":["Urdu A1 generation corpus","Urdu A2 Units 1-6"],"quality":{"answer_key_check":"pending","coverage_check":"pending","fact_check":"not_required","linguistic_review":"pending","notes":["High-quality Urdu A2 generation-stage draft; formal linguistic, pedagogical, lexical-coverage, answer-key, and schema audits are deferred to the designated final multi-pass review phase.","Written independently in contemporary standard Urdu for the A2 community-events-and-simple-news roadmap; not translated from the Arabic or French corpora.","The local reports/announcements are constructed educational scenarios and do not assert real-world local events.","The deliberate learner-facing senses introduced in this unit were independently checked against the project Urdu lexicon and external dictionary evidence on 2026-08-24; persistent bounded evidence is stored in reading/audit/urdu_a2_u07_lexical_sense_check_2026-08-24.json.","Pre-canonical Urdu A2 Unit 7 reader-first quality pass completed 2026-08-24 for naturalness, target-sense clarity, answer grounding, operational grammar, and fluency new-word policy; formal release gates remain pending."],"pedagogical_review":"pending","schema_check":"pending","status":"draft"},"questions":[{"answer_id":"a1","id":"q1","prompt":"صفائی کی سرگرمی کی رپورٹ کا بنیادی پیغام کیا ہے؟","type":"gist"},{"answer_id":"a2","id":"q2","prompt":"رضاکار کن دو طرح کے کاموں میں سرگرم تھے؟","type":"literal_detail","target_ids":["ur-rank-0646"]},{"answer_id":"a3","id":"q3","prompt":"دو گھنٹے بعد کیا کیا گیا؟","type":"sequence"},{"answer_id":"a4","id":"q4","prompt":"منتظمین نے تھیلوں کی تعداد کو مکمل نتیجہ کیوں نہیں کہا؟","type":"inference","target_ids":["ur-rank-0622"]},{"answer_id":"a5","id":"q5","prompt":"عبارت میں «نتیجہ» سے کیا مراد ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0622"]},{"answer_id":"a6","id":"q6","prompt":"«سرگرم رہے» کا کیا مطلب ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0646"]},{"answer_id":"a7","id":"q7","prompt":"جملہ مکمل کریں: اگر پچھلا حصہ گندا رہے _____ اگلی سرگرمی میں اسے ترجیح دی جائے گی۔","type":"grammar_choice"},{"answer_id":"a8","id":"q8","prompt":"«اس گفتگو کا نتیجہ» کس گفتگو کی طرف اشارہ کرتا ہے؟","type":"reference_resolution"},{"answer_id":"a9","id":"q9","prompt":"خالی جگہ پُر کریں: مسلسل کام میں حصہ لینے والے رضاکار _____ تھے۔","type":"cloze_transfer","target_ids":["ur-rank-0646"]},{"answer_id":"a10","id":"q10","prompt":"رپورٹ کے مطابق سرگرمی کا ایک فوری اور ایک بعد میں جانچا جانے والا نتیجہ لکھیں۔","type":"summary","target_ids":["ur-rank-0622"]}],"reader_tags":["unit_role:interleaved","generation_batch","a2"],"review_lexical_targets":[{"id":"ur-rank-0586","form":"خبر","review_stage":"R1","representation":"running_text"}],"revision":1,"sentence_count":10,"sequence":39,"speed_training":{"benchmark_eligible":false,"comprehension_gate":0.8,"new_word_policy":"controlled","notes":"A2 generation-stage passage; formal fluency/coverage decision deferred to final audit.","timed":false},"text":"گزشتہ ہفتے محلے کے پارک میں صفائی کی ایک رضاکارانہ سرگرمی ہوئی۔ صبح کے وقت تقریباً چالیس لوگ مختلف حصوں میں سرگرم رہے۔ کچھ رضاکار راستوں سے کاغذ اور پلاسٹک جمع کرتے رہے، جبکہ دوسرے لوگ پودوں کے قریب خشک شاخیں ہٹانے میں سرگرم تھے۔ منتظمین نے کام شروع ہونے سے پہلے بتایا تھا کہ مقصد صرف ایک دن پارک صاف دکھانا نہیں، بلکہ یہ دیکھنا بھی ہے کہ مشترکہ کوشش کا کیا نتیجہ نکلتا ہے۔ دو گھنٹے بعد جمع کیے گئے تھیلوں کی تعداد نوٹ کی گئی اور راستوں کی حالت دوبارہ دیکھی گئی۔ ابتدائی نتیجہ یہ تھا کہ کھیل کے میدان اور مرکزی راستے میں واضح بہتری آئی۔ چند رضاکار آخر تک سرگرم رہے اور انہوں نے آنے والوں سے پوچھا کہ کون سی جگہ اب بھی زیادہ توجہ چاہتی ہے۔ اس گفتگو کا نتیجہ یہ نکلا کہ اگلی سرگرمی میں پارک کے پچھلے حصے کو ترجیح دی جائے گی۔ منتظمین نے کہا کہ صرف تھیلوں کی تعداد کامیابی کا مکمل نتیجہ نہیں ہے؛ لوگوں کی شرکت اور بعد میں صفائی برقرار رہنا بھی اہم ہے۔ سرگرم رضاکاروں نے اگلی تاریخ کے بارے میں اطلاع مانگی، لیکن وہ ابھی طے نہیں ہوئی۔","title":"پارک کی صفائی کا نتیجہ","topics":["community events","simple news","local information"],"unit":7,"word_count":194}