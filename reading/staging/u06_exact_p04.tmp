ew":"pending","schema_check":"pending","status":"draft"},"questions":[{"answer_id":"a1","id":"q1","prompt":"مریم کو عجائب گھر میں داخل ہونے میں شروع میں کیا مسئلہ ہوا؟","type":"gist"},{"answer_id":"a2","id":"q2","prompt":"زائرین کو کس طرف کے دروازے سے جانا تھا؟","type":"literal_detail"},{"answer_id":"a3","id":"q3","prompt":"ملازم کی بات کے بعد مریم نے صحیح دروازہ کیسے تلاش کیا؟","type":"sequence"},{"answer_id":"a4","id":"q4","prompt":"چھوٹا نقشہ مریم کے لیے کیوں مفید تھا؟","type":"inference","target_ids":["ur-rank-0931"]},{"answer_id":"a5","id":"q5","prompt":"عبارت میں «داخلہ» سے کیا مراد ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0820"]},{"answer_id":"a6","id":"q6","prompt":"«آسانی ہوئی» کا کیا مطلب ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0931"]},{"answer_id":"a7","id":"q7","prompt":"جملہ مکمل کریں: مرکزی دروازہ بند تھا، _____ مریم متبادل داخلے کی طرف گئی۔","type":"grammar_choice"},{"answer_id":"a8","id":"q8","prompt":"«ان علامتوں کی وجہ سے» میں «ان علامتوں» سے کیا مراد ہے؟","type":"reference_resolution"},{"answer_id":"a9","id":"q9","prompt":"خالی جگہ پُر کریں: واضح نقشے سے مسافروں کو راستہ تلاش کرنے میں _____ ہوتی ہے۔","type":"cloze_transfer","target_ids":["ur-rank-0931"]},{"answer_id":"a10","id":"q10","prompt":"مریم کے تجربے سے کسی جگہ جانے سے پہلے کیا دو معلومات دیکھنا مفید ہے؟","type":"summary","target_ids":["ur-rank-0820"]}],"reader_tags":["unit_role:transfer","generation_batch","a2"],"review_lexical_targets":[{"form":"تصویر","id":"ur-rank-0917","representation":"running_text","review_stage":"R2"}],"revision":1,"sentence_count":12,"sequence":34,"speed_training":{"benchmark_eligible":false,"comprehension_gate":0.8,"new_word_policy":"controlled","notes":"A2 generation-stage passage; formal fluency/coverage decision deferred to final audit.","timed":false},"text":"مریم ایک تاریخی عجائب گھر دیکھنے کے لیے دوسرے شہر گئی۔ اس نے آن لائن پڑھا تھا کہ عام داخلہ صبح نو بجے سے شروع ہوتا ہے، اس لیے وہ ساڑھے نو بجے پہنچ گئی۔ دروازے پر معلوم ہوا کہ مرمت کے باعث مرکزی داخلہ بند ہے اور زائرین کو پچھلی طرف کے داخلہ دروازے سے جانا ہوگا۔ مریم نے نقشہ دیکھا، مگر پہلی بار راستہ سمجھنے میں اسے مشکل ہوئی۔ قریب کھڑے ملازم نے بتایا کہ نئی علامتوں پر نیلے تیر بنے ہیں تاکہ لوگوں کو آسانی سے دوسرا دروازہ مل سکے۔ ان علامتوں کی وجہ سے مریم کو واقعی آسانی ہوئی اور وہ چند منٹ میں صحیح جگہ پہنچ گئی۔ وہاں ٹکٹ دکھانے کے بعد اسے داخلہ مل گیا۔ اندر ایک معلوماتی میز پر چھوٹا نقشہ بھی موجود تھا جس سے کمروں تک جانے میں آسانی رہی۔ مریم نے سوچا کہ اگر وہ صرف پرانے نقشے پر بھروسا کرتی تو شاید دیر ہو جاتی۔ واپسی پر اس نے دوست کو پیغام لکھا کہ عجائب گھر اچھا ہے، لیکن مرکزی داخلہ عارضی طور پر بند ہے۔ اس نے بتایا کہ متبادل داخلہ واضح نشانات کے ساتھ کھلا ہے، اس لیے زیادہ پریشانی نہیں ہوتی۔ اس سفر سے مریم نے سیکھا کہ داخلے کے وقت اور راستے کی تازہ معلومات دیکھ لینے سے سفر میں بہت آسانی رہتی ہے۔","title":"عجائب گھر کا دوسرا داخلہ","topics":["museum visit","entrance","wayfinding"],"unit":6,"word_count":219}