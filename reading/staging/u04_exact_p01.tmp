{"answer_key":[{"answer":"دو لیمپوں کے معیار، کام اور قیمت کے تجربے کا موازنہ کرنا۔","explanation":"","id":"a1","question_id":"q1"},{"answer":"اس کا سوئچ خراب ہو گیا۔","explanation":"","id":"a2","question_id":"q2"},{"answer":"شیلف پر لکھی دو ہزار روپے کی قیمت اور رسید میں درج دو ہزار دو سو روپے کی قیمت کی طرف۔","explanation":"","id":"a3","question_id":"q3"},{"answer":"کیونکہ وہ ٹھیک کام کر رہا تھا، مضبوط تھا اور اس کی قیمت میں بھی کوئی اختلاف نہیں تھا۔","explanation":"","id":"a4","question_id":"q4"},{"answer":"سوئچ ٹھیک طرح کام نہیں کر رہا تھا۔","explanation":"","id":"a5","question_id":"q5"},{"answer":"دو جگہ لکھی قیمتوں کا ایک جیسا نہ ہونا یا ان میں فرق ہونا۔","explanation":"","id":"a6","question_id":"q6"},{"answer":"سے","explanation":"","id":"a7","question_id":"q7"},{"answer":"اس لیے","explanation":"","id":"a8","question_id":"q8"},{"answer":"خراب","explanation":"","id":"a9","question_id":"q9"},{"answer":"یہ دیکھنا چاہیے کہ چیز ٹھیک کام کرتی ہے اور رسید یا درج قیمت میں کوئی اختلاف نہیں۔","explanation":"","id":"a10","question_id":"q10"}],"cefr":"A2","complexity_profile":{"clause_count":null,"connective_diversity":null,"coordination_count":null,"inference_depth":"local_to_two_sentence","lexical_diversity":null,"mean_sentence_length":null,"median_sentence_length":null,"morphology_notes":"A2 generation-stage draft; contemporary standard Urdu with comparisons, practical conditions, and controlled problem-solution links.","multiword_expression_count":null,"reference_chain_max_distance":null,"subordination_count":null},"difficulty_notes_internal":"A2 Unit 04 generation draft: shopping comparison, price/condition problems, returns, evidence, and practical resolution.","discourse_targets":[{"description":"compare product quality and a price discrepancy in a short consumer review","id":"ur-a2-u04-product-review","role":"new"}],"domains":["personal","public"],"estimated_known_token_coverage":0,"genre":"review","grammar_targets":[{"description":"use سے for simple product comparison","id":"ur-a2-comparative-se","role":"new"},{"description":"use اس لیے for problem-to-action links","id":"ur-a2-cause-isliye","role":"review"}],"id":"ur-a2-u04-p01","language":"ur","new_lexical_targets":[{"beyond_base":false,"context_strategy":["scenario_resolution"],"exposures_in_text":3,"first_introduced":true,"form":"خراب","id":"ur-rank-0690","intended_sense":"defective; not working properly; in bad condition","lemma":"خراب","part_of_speech":"adjective","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":690,"variety":"contemporary standard Urdu"},{"beyond_base":false,"context_strategy":["contrast"],"exposures_in_text":3,"first_introduced":true,"form":"اختلاف","id":"ur-rank-0769","intended_sense":"difference; discrepancy; mismatch between two details","lemma":"اختلاف","part_of_speech":"noun","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":769,"variety":"contemporary standard Urdu"}],"paired_text_group":null,"passage_type":"instructional","prerequisites":["Urdu A1 generation corpus","Urdu A2 Units 1-3"],"quality":{"answer_key_check":"pending","coverage_check":"pending","fact_check":"not_required","linguistic_review":"pending","notes":["High-quality Urdu A2 generation-stage draft; formal linguistic, pedagogical, lexical-coverage, answer-key, and schema audits are deferred to the designated final multi-pass review phase.","Written independently in contemporary standard Urdu for the A2 shopping-comparison-and-problems roadmap; not translated from the Arabic or French corpora.","The deliberate learner-facing senses introduced in this unit were independently checked against the project Urdu lexicon and Rekhta Dictionary on 2026-08-24; persistent bounded evidence is stored in reading/audit/urdu_a2_u04_lexical_sense_check_2026-08-24.json.","Pre-canonical Urdu A2 Unit 4 reader-first quality pass completed 2026-08-24 for naturalness, target-sense clarity, answer grounding, operational grammar, and fluency new-word policy; formal release gates remain pending."],"pedagogical_review":"pending","schema_check":"pending","status":"draft"},"questions":[{"answer_id":"a1","id":"q1","prompt":"حنا کے جائزے کا بنیادی مقصد کیا تھا؟","type":"gist"},{"answer_id":"a2","id":"q2","prompt":"پہلے لیمپ میں دو دن بعد کیا مسئلہ ہوا؟","type":"literal_detail"},{"answer_id":"a3","id":"q3","prompt":"«اس اختلاف کی وجہ» میں «اختلاف» کن دو قیمتوں کے فرق کی طرف اشارہ کرتا ہے؟","target_ids":["ur-rank-0769"],"type":"reference_resolution"},{"answer_id":"a4","id":"q4","prompt":"حنا نے دوسرے لیمپ کو بہتر انتخاب کیوں کہا؟","type":"inference"},{"answer_id":"a5","id":"q5","prompt":"عبارت میں «سوئچ خراب ہو گیا» میں «خراب» کا کیا مطلب ہے؟","target_ids":["ur-rank-0690"],"type":"vocabulary_in_context"},{"answer_id":"a6","id":"q6","prompt":"«قیمت میں اختلاف» سے کیا مراد ہے؟","target_ids":["ur-rank-0769"],"type":"vocabulary_in_context"},{"answer_id":"a7","id":"q7","prompt":"جملہ مکمل کریں: دوسرا لیمپ پہلے لیمپ _____ کچھ مہنگا تھا۔","type":"grammar_choice"},{"answer_id":"a8","id":"q8","prompt":"درست ربط چنیں: سوئچ خراب ہو گیا، _____ حنا نے دکان سے رابطہ کیا۔","type":"grammar_choice"},{"answer_id":"a9","id":"q9","prompt":"خالی جگہ پُر کریں: اگر نئی گھڑی کام نہ کرے تو کہا جا سکتا ہے کہ وہ _____ ہے۔","target_ids":["ur-rank-0690"],"type":"cloze_transfer"},{"answer_id":"a10","id":"q10","prompt":"حنا کے تجربے کے مطابق چیز خریدتے وقت کن دو باتوں کو قیمت کے علاوہ دیکھنا چاہیے؟","type":"summary"}],"reader_tags":["unit_role:instructional","generation_batch","a2"],"review_lexical_targets":[{"form":"رابطہ","id":"ur-rank-0560","representation":"running_text","review_stage":"R2"}],"revision":1,"sentence_count":9,"sequence":19,"speed_training":{"benchmark_eligible":false,"comprehension_gate":0.8,"new_word_policy":"controlled","notes":"A2 generation-stage passage; formal fluency/coverage decision deferred to final audit.","timed":false},"text":"حنا نے اپنے مطالعے کی میز کے لیے دو چھوٹے لیمپ آزمائے اور بعد میں ایک مختصر جائزہ لکھا۔ پہلا لیمپ سستا تھا اور اس کی روشنی مناسب تھی، لیکن دو دن بعد اس کا سوئچ خراب ہو گیا۔ حنا نے دکان سے رابطہ کیا تو ملازم نے کہا کہ خراب لیمپ رسید کے ساتھ واپس لایا جا سکتا ہے۔ رسید دیکھتے وقت حنا نے ایک اور بات نوٹ کی: شیلف پر قیمت دو ہزار روپے لکھی تھی، مگر رسید میں دو ہزار دو سو روپے درج تھے۔ اس اختلاف کی وجہ جاننے کے لیے اس نے قیمت کی تصویر بھی دکھائی۔ ملازم نے تصدیق کی کہ واقعی قیمت میں اختلاف تھا اور اضافی رقم واپس کر دی۔ حنا نے دوسرا لیمپ بھی دیکھا، جو کچھ مہنگا تھا مگر اس کا سوئچ مضبوط اور روشنی زیادہ واضح تھی۔ اپنے جائزے میں اس نے لکھا کہ صرف کم قیمت دیکھنا کافی نہیں؛ یہ بھی دیکھنا چاہیے کہ چیز ٹھیک کام کر رہی ہے یا خراب، اور رسید کی قیمت دکان کی لکھی ہوئی قیمت سے ملتی ہے یا نہیں۔ آخر میں اس نے دوسرے لیمپ کو بہتر انتخاب کہا، کیونکہ اس میں نہ فنی مسئلہ تھا اور نہ قیمت میں کوئی اختلاف تھا۔","title":"دو لیمپوں کا جائزہ","topics":["shopping","comparison","price discrepancy"],"unit":4,"word_count":202}