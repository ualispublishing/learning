l_review":"pending","schema_check":"pending","status":"draft"},"questions":[{"answer_id":"a1","id":"q1","prompt":"علی کے پیغام کا بنیادی مقصد کیا ہے؟","type":"gist"},{"answer_id":"a2","id":"q2","prompt":"متبادل سڑک کہاں سے گزرتی ہے؟","type":"literal_detail"},{"answer_id":"a3","id":"q3","prompt":"بدلے ہوئے راستے سے سفر تقریباً کتنا زیادہ ہو سکتا ہے؟","type":"literal_detail"},{"answer_id":"a4","id":"q4","prompt":"علی نے حسن کو تبدیلی پہلے کیوں بتائی؟","type":"inference"},{"answer_id":"a5","id":"q5","prompt":"عبارت میں «سڑک» سے کیا مراد ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0847"]},{"answer_id":"a6","id":"q6","prompt":"«تبدیلی سے آگاہ» ہونے کا کیا مطلب ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0835"]},{"answer_id":"a7","id":"q7","prompt":"جملہ مکمل کریں: مرکزی سڑک بند ہے، _____ بس متبادل راستے سے جائے گی۔","type":"grammar_choice"},{"answer_id":"a8","id":"q8","prompt":"«یہی سرکاری متبادل راستہ ہے» میں «یہی» کس طرف اشارہ کرتا ہے؟","type":"reference_resolution"},{"answer_id":"a9","id":"q9","prompt":"خالی جگہ پُر کریں: مسافروں کو نئے وقت سے _____ کیا گیا۔","type":"cloze_transfer","target_ids":["ur-rank-0835"]},{"answer_id":"a10","id":"q10","prompt":"حسن کو روانگی سے پہلے کون سا عملی قدم اٹھانا چاہیے؟","type":"paraphrase"}],"reader_tags":["unit_role:reinforcement","generation_batch","a2"],"review_lexical_targets":[{"form":"اطلاع","id":"ur-rank-0901","representation":"running_text","review_stage":"R2"},{"form":"انتظار","id":"ur-rank-0858","representation":"running_text","review_stage":"R2"}],"revision":1,"sentence_count":11,"sequence":32,"speed_training":{"benchmark_eligible":false,"comprehension_gate":0.8,"new_word_policy":"controlled","notes":"A2 generation-stage passage; formal fluency/coverage decision deferred to final audit.","timed":false},"text":"علی نے اپنے دوست حسن کو سفر سے پہلے پیغام بھیجا: “کل اگر تم بس سے میرے شہر آ رہے ہو تو ایک اہم بات سے آگاہ رہنا۔ مرکزی سڑک پر مرمت ہو رہی ہے، اس لیے بس پرانے راستے سے نہیں آئے گی۔ کمپنی نے بتایا ہے کہ متبادل سڑک دریا کے قریب سے گزرتی ہے اور سفر میں تقریباً پندرہ منٹ زیادہ لگ سکتے ہیں۔ میں نے یہ اطلاع اس لیے بھیجی ہے تاکہ تم تبدیلی سے پہلے ہی آگاہ ہو جاؤ اور اسٹیشن پر پریشان نہ ہو۔ اگر ڈرائیور دوسری سڑک اختیار کرے تو فکر نہ کرنا؛ یہی سرکاری متبادل راستہ ہے۔ شہر میں داخل ہونے کے بعد بس بازار والی سڑک کے بجائے شمالی سڑک سے مرکزی اسٹیشن پہنچے گی۔ تم اپنے فون میں کمپنی کا تازہ پیغام بھی دیکھ لینا، کیونکہ وہ مسافروں کو وقت کی تبدیلی سے آگاہ کر رہے ہیں۔ میں تمہاری آمد کے قریب دوبارہ اسٹیشن کا حال دیکھوں گا۔ اگر مرمت جلد ختم ہو گئی تو شاید بس عام سڑک پر واپس آ جائے، لیکن ابھی اسی پر بھروسا نہ کرنا۔ پہنچنے سے دس منٹ پہلے مجھے پیغام کر دینا تاکہ میں باہر انتظار کر سکوں۔” حسن نے جواب دیا کہ وہ سڑک کی تبدیلی سے آگاہ ہے اور روانگی سے پہلے کمپنی کی اطلاع دوبارہ دیکھ لے گا۔","title":"بدلی ہوئی سڑک کا پیغام","topics":["bus travel","road change","travel message"],"unit":6,"word_count":218}