{"answer_key":[{"answer":"حسن کو مرکزی سڑک کی مرمت اور بس کے بدلے ہوئے راستے سے آگاہ کرنا۔","explanation":"","id":"a1","question_id":"q1"},{"answer":"دریا کے قریب سے۔","explanation":"","id":"a2","question_id":"q2"},{"answer":"تقریباً پندرہ منٹ۔","explanation":"","id":"a3","question_id":"q3"},{"answer":"تاکہ حسن راستہ بدلنے پر پریشان نہ ہو اور نئے وقت کے لیے تیار رہے۔","explanation":"","id":"a4","question_id":"q4"},{"answer":"گاڑیوں اور لوگوں کے سفر کے لیے بنا ہوا راستہ یا روڈ۔","explanation":"","id":"a5","question_id":"q5"},{"answer":"تبدیلی کے بارے میں معلومات رکھنا یا پہلے سے باخبر ہونا۔","explanation":"","id":"a6","question_id":"q6"},{"answer":"اس لیے","explanation":"","id":"a7","question_id":"q7"},{"answer":"دوسری یا متبادل سڑک کی طرف جسے بس استعمال کرے گی۔","explanation":"","id":"a8","question_id":"q8"},{"answer":"آگاہ","explanation":"","id":"a9","question_id":"q9"},{"answer":"بس کمپنی کا تازہ پیغام دوبارہ دیکھنا چاہیے تاکہ راستے اور وقت کی موجودہ معلومات معلوم ہوں۔","explanation":"","id":"a10","question_id":"q10"}],"cefr":"A2","complexity_profile":{"clause_count":null,"connective_diversity":null,"coordination_count":null,"inference_depth":"local_to_two_sentence","lexical_diversity":null,"mean_sentence_length":null,"median_sentence_length":null,"morphology_notes":"A2 generation-stage draft; contemporary standard Urdu with connected travel narratives, practical information, and controlled cause-effect.","multiword_expression_count":null,"reference_chain_max_distance":null,"subordination_count":null},"difficulty_notes_internal":"A2 Unit 06 generation draft: transport, route changes, arrival timing, accommodation, entry, safety, and practical travel decisions.","discourse_targets":[{"description":"communicate a route change before travel","id":"ur-a2-u06-discourse-p02","role":"new"}],"domains":["personal","public"],"estimated_known_token_coverage":0,"genre":"message","grammar_targets":[{"description":"اس لیے for road closure and alternate route","id":"ur-a2-route-