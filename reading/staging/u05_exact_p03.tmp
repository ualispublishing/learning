{"answer_key":[{"answer":"واضح مقصد اور مناسب تیاری۔","explanation":"","id":"a1","question_id":"q1"},{"answer":"ایک مہینے میں پانچ آسان کھانے خود بنانا۔","explanation":"","id":"a2","question_id":"q2"},{"answer":"کھانوں کی فہرست، ضروری برتن اور عام اجزا۔","explanation":"","id":"a3","question_id":"q3"},{"answer":"کیونکہ واضح مقصد کے بغیر کتابیں، ویڈیو یا سامان استعمال ہی نہیں ہو سکتے۔","explanation":"","id":"a4","question_id":"q4"},{"answer":"شروع کرنے سے پہلے ضروری معلومات، سامان اور طریقہ تیار کرنا۔","explanation":"","id":"a5","question_id":"q5"},{"answer":"وہ نتیجہ یا ہدف جس تک سیکھنے والا پہنچنا چاہتا ہے۔","explanation":"","id":"a6","question_id":"q6"},{"answer":"اصل مقصد کی طرف۔","explanation":"","id":"a7","question_id":"q7"},{"answer":"تو","explanation":"","id":"a8","question_id":"q8"},{"answer":"تیاری","explanation":"","id":"a9","question_id":"q9"},{"answer":"مثلاً: میں چار ہفتوں میں روزمرہ کے دس بنیادی گٹار سُر صحیح بجانا سیکھوں گا۔","explanation":"","id":"a10","question_id":"q10"}],"cefr":"A2","complexity_profile":{"clause_count":null,"connective_diversity":null,"coordination_count":null,"inference_depth":"local_to_two_sentence","lexical_diversity":null,"mean_sentence_length":null,"median_sentence_length":null,"morphology_notes":"A2 generation-stage draft; contemporary standard Urdu with connected learning narratives, practical instructions, and controlled cause-effect.","multiword_expression_count":null,"reference_chain_max_distance":null,"subordination_count":null},"difficulty_notes_internal":"A2 Unit 05 generation draft: hobbies, guided practice, learning goals, study routines, reflection, and controlled transfer.","discourse_targets":[{"id":"ur-a2-u05-goal-preparation","role":"new","description":"explain how a clear goal shapes practical preparation"}],"domains":["personal","educational"],"estimated_known_token_coverage":0,"genre":"short article","grammar_targets":[{"id":"ur-a2-goal-if","role":"new","description":"اگر ... تو for adapting a learning goal"},{"id":"ur-a2-purpose-prep","role":"review","description":"purpose statements linking preparation to a goal"}],"id":"ur-a2-u05-p03","language":"ur","new_lexical_targets":[{"beyond_base":false,"context_strategy":["procedural_reasoning"],"exposures_in_text":4,"first_introduced":true,"form":"تیاری","id":"ur-rank-0774","intended_sense":"preparation; getting ready","lemma":"تیاری","part_of_speech":"noun","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":774,"variety":"contemporary standard Urdu"},{"beyond_base":false,"context_strategy":["procedural_reasoning"],"exposures_in_text":6,"first_introduced":true,"form":"مقصد","id":"ur-rank-0695","intended_sense":"purpose; aim; goal","lemma":"مقصد","part_of_speech":"noun","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":695,"variety":"contemporary standard Urdu"}],"paired_text_group":null,"passage_type":"interleaved","prerequisites":["Urdu A1 generation corpus","Urdu A2 Units 1-4"],"quality":{"answer_key_check":"pending","coverage_check":"pending","fact_check":"not_required","linguistic_review":"pending","notes":["High-quality Urdu A2 generation-stage draft; formal linguistic, pedagogical, lexical-coverage, answer-key, and schema audits are deferred to the designated final multi-pass review phase.","Written independently in contemporary standard Urdu for the A2 hobbies-and-learning-skills roadmap; not translated from the Arabic or French corpora.","The deliberate learner-facing senses introduced in this unit were independently checked against the project Urdu lexicon and external dictionary evidence on 2026-08-24; persistent bounded evidence is stored in reading/audit/urdu_a2_u05_lexical_sense_check_2026-08-24.json.","Pre-canonical Urdu A2 Unit 5 reader-first quality pass completed 2026-08-24 for naturalness, target-sense clarity, answer grounding, operational grammar, and fluency new-word policy; formal release gates remain pending."],"pedagogical_review":"pending","schema_check":"pending","status":"draft"},"questions":[{"answer_id":"a1","id":"q1","prompt":"مضمون کے مطابق نئی مہارت سیکھنے سے پہلے کیا دو چیزیں خاص طور پر مفید ہیں؟","type":"gist"},{"answer_id":"a2","id":"q2","prompt":"کھانا پکانے کی مثال میں ایک مہینے کا مقصد کیا تھا؟","type":"literal_detail"},{"answer_id":"a3","id":"q3","prompt":"مقصد لکھنے کے بعد تیاری کے طور پر کن چیزوں کو دیکھنے کا مشورہ دیا گیا ہے؟","type":"sequence"},{"answer_id":"a4","id":"q4","prompt":"بہت سا سامان پہلے ہی جمع کر لینا ہمیشہ مفید کیوں نہیں؟","type":"inference"},{"answer_id":"a5","id":"q5","prompt":"عبارت میں «تیاری» سے کیا مراد ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0774"]},{"answer_id":"a6","id":"q6","prompt":"«مقصد واضح ہو» میں «مقصد» کا کیا مطلب ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0695"]},{"answer_id":"a7","id":"q7","prompt":"«اگر وہ بہت بڑا تھا تو اسے چھوٹے حصوں میں تقسیم کریں» میں «وہ» کس کی طرف اشارہ کرتا ہے؟","type":"reference_resolution"},{"answer_id":"a8","id":"q8","prompt":"جملہ مکمل کریں: اگر مقصد بڑا ہو _____ اسے چھوٹے حصوں میں تقسیم کریں۔","type":"grammar_choice"},{"answer_id":"a9","id":"q9","prompt":"خالی جگہ پُر کریں: امتحان سے پہلے نوٹس اور کتابیں منظم کرنا اچھی _____ ہے۔","type":"cloze_transfer","target_ids":["ur-rank-0774"]},{"answer_id":"a10","id":"q10","prompt":"ایک نئی مہارت کے لیے قابلِ عمل مقصد کی اپنی مثال دیں۔","type":"paraphrase","target_ids":["ur-rank-0695"]}],"reader_tags":["unit_role:interleaved","generation_batch","a2"],"review_lexical_targets":[{"id":"ur-rank-0813","form":"باقاعدہ","review_stage":"R1","representation":"running_text"}],"revision":1,"sentence_count":10,"sequence":27,"speed_training":{"benchmark_eligible":false,"comprehension_gate":0.8,"new_word_policy":"controlled","notes":"A2 generation-stage passage; formal fluency/coverage decision deferred to final audit.","timed":false},"text":"کسی نئی مہارت کو سیکھنے سے پہلے تھوڑی تیاری وقت بچا سکتی ہے۔ بہت سے لوگ پہلے دن جوش میں کئی کتابیں، ویڈیو یا سامان جمع کر لیتے ہیں، لیکن اگر مقصد واضح نہ ہو تو یہ چیزیں استعمال نہیں ہوتیں۔ مثال کے طور پر اگر آپ کو بنیادی کھانا پکانا سیکھنا ہے تو پہلے اپنا مقصد ایک جملے میں لکھیں: “میں ایک مہینے میں پانچ آسان کھانے خود بنانا چاہتا ہوں۔” پھر تیاری کے طور پر انہی کھانوں کی فہرست، ضروری برتن اور عام اجزا دیکھیں۔ ہر ہفتے ایک یا دو ترکیبیں منتخب کریں اور پہلی کوشش کے بعد مختصر نوٹ لکھیں کہ کیا آسان تھا اور کہاں مشکل ہوئی۔ اگر مقصد صرف نئی چیز آزمانا ہے تو مکمل مہارت کی توقع نہ رکھیں؛ اگر مقصد خاندان کے لیے باقاعدہ کھانا بنانا ہے تو مقدار اور وقت کی مشق بھی ضروری ہوگی۔ اچھی تیاری کا مطلب ہر بات پہلے سے طے کرنا نہیں، بلکہ شروع کرنے کے لیے کافی معلومات اور مناسب سامان رکھنا ہے۔ چند ہفتوں بعد اپنے اصل مقصد پر دوبارہ نظر ڈالیں۔ اگر وہ بہت بڑا تھا تو اسے چھوٹے حصوں میں تقسیم کریں۔ واضح مقصد اور مناسب تیاری مل کر سیکھنے کو زیادہ منظم بناتے ہیں اور غیر ضروری کام کم کرتے ہیں۔","title":"مہارت سیکھنے کی تیاری","topics":["learning strategy","preparation","goal"],"unit":5,"word_count":208}