{"answer_key":[{"answer":"کیونکہ وہ بہت کچھ پڑھتی تھی مگر بعد میں اہم باتیں بھول جاتی تھی۔","explanation":"","id":"a1","question_id":"q1"},{"answer":"عنوان اور ذیلی عنوان۔","explanation":"","id":"a2","question_id":"q2"},{"answer":"کتاب بند کر کے اہم خیال اور غیر واضح بات پر غور کرتی ہے، پھر چند جملے اپنے الفاظ میں لکھتی ہے۔","explanation":"","id":"a3","question_id":"q3"},{"answer":"کیونکہ وہ صرف اپنے سوال سے متعلق اہم جملے نوٹ کرنا چاہتی ہے۔","explanation":"","id":"a4","question_id":"q4"},{"answer":"کسی موضوع کو سمجھنے کے لیے توجہ سے پڑھنا یا اس کا مطالعہ کرنا۔","explanation":"","id":"a5","question_id":"q5"},{"answer":"کسی بات پر توجہ سے سوچنا اور اس پر غور و فکر کرنا۔","explanation":"","id":"a6","question_id":"q6"},{"answer":"سوال طے کرنا، متعلقہ نکات نوٹ کرنا، پھر اہم خیال پر سوچ کر اپنے الفاظ میں لکھنا۔","explanation":"","id":"a7","question_id":"q7"},{"answer":"تو","explanation":"","id":"a8","question_id":"q8"},{"answer":"مطالعہ","explanation":"","id":"a9","question_id":"q9"},{"answer":"یہ دیکھنا کہ کیا سمجھ آیا اور یہ پہچاننا کہ کس حصے پر دوبارہ توجہ چاہیے۔","explanation":"","id":"a10","question_id":"q10"}],"cefr":"A2","complexity_profile":{"clause_count":null,"connective_diversity":null,"coordination_count":null,"inference_depth":"local_to_two_sentence","lexical_diversity":null,"mean_sentence_length":null,"median_sentence_length":null,"morphology_notes":"A2 generation-stage draft; contemporary standard Urdu with connected learning narratives, practical instructions, and controlled cause-effect.","multiword_expression_count":null,"reference_chain_max_distance":null,"subordination_count":null},"difficulty_notes_internal":"A2 Unit 05 generation draft: hobbies, guided practice, learning goals, study routines, reflection, and controlled transfer.","discourse_targets":[{"id":"ur-a2-u05-study-reflection","role":"new","description":"describe a reading routine that includes deliberate reflection"}],"domains":["personal","educational"],"estimated_known_token_coverage":0,"genre":"profile","grammar_targets":[{"id":"ur-a2-after-reading","role":"new","description":"بعد / پھر for post-reading reflection"},{"id":"ur-a2-if-unclear","role":"review","description":"اگر ... تو for rereading unclear material"}],"id":"ur-a2-u05-p04","language":"ur","new_lexical_targets":[{"beyond_base":false,"context_strategy":["scenario_resolution"],"exposures_in_text":4,"first_introduced":true,"form":"مطالعہ","id":"ur-rank-0944","intended_sense":"study; reading undertaken to understand a subject","lemma":"مطالعہ","part_of_speech":"noun","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":944,"variety":"contemporary standard Urdu"},{"beyond_base":false,"context_strategy":["procedural_reasoning"],"exposures_in_text":3,"first_introduced":true,"form":"غور","id":"ur-rank-0961","intended_sense":"careful thought; consideration; close attention","lemma":"غور","part_of_speech":"noun","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":961,"variety":"contemporary standard Urdu"}],"paired_text_group":null,"passage_type":"transfer","prerequisites":["Urdu A1 generation corpus","Urdu A2 Units 1-4"],"quality":{"answer_key_check":"pending","coverage_check":"pending","fact_check":"not_required","linguistic_review":"pending","notes":["High-quality Urdu A2 generation-stage draft; formal linguistic, pedagogical, lexical-coverage, answer-key, and schema audits are deferred to the designated final multi-pass review phase.","Written independently in contemporary standard Urdu for the A2 hobbies-and-learning-skills roadmap; not translated from the Arabic or French corpora.","The deliberate learner-facing senses introduced in this unit were independently checked against the project Urdu lexicon and external dictionary evidence on 2026-08-24; persistent bounded evidence is stored in reading/audit/urdu_a2_u05_lexical_sense_check_2026-08-24.json.","Pre-canonical Urdu A2 Unit 5 reader-first quality pass completed 2026-08-24 for naturalness, target-sense clarity, answer grounding, operational grammar, and fluency new-word policy; formal release gates remain pending."],"pedagogical_review":"pending","schema_check":"pending","status":"draft"},"questions":[{"answer_id":"a1","id":"q1","prompt":"مہرین نے اپنے مطالعے کا طریقہ کیوں بدلا؟","type":"gist"},{"answer_id":"a2","id":"q2","prompt":"مطالعہ شروع کرنے سے پہلے مہرین کن دو چیزوں کو دیکھتی ہے؟","type":"literal_detail"},{"answer_id":"a3","id":"q3","prompt":"ایک باب مکمل کرنے کے بعد مہرین کیا کرتی ہے؟","type":"sequence"},{"answer_id":"a4","id":"q4","prompt":"مہرین ہر جملے پر نشان کیوں نہیں لگاتی؟","type":"inference"},{"answer_id":"a5","id":"q5","prompt":"عبارت میں «مطالعہ» سے کیا مراد ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0944"]},{"answer_id":"a6","id":"q6","prompt":"«دو منٹ غور کرتی ہے» میں «غور» کا کیا مطلب ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0961"]},{"answer_id":"a7","id":"q7","prompt":"«اس طریقے سے مطالعہ تھوڑا آہستہ ہوا» میں «اس طریقے» سے کیا مراد ہے؟","type":"reference_resolution"},{"answer_id":"a8","id":"q8","prompt":"جملہ مکمل کریں: اگر بات واضح نہ ہو _____ اس حصے کو دوبارہ پڑھیں۔","type":"grammar_choice"},{"answer_id":"a9","id":"q9","prompt":"خالی جگہ پُر کریں: کسی موضوع کو سمجھنے کے لیے کتابوں کا _____ مفید ہو سکتا ہے۔","type":"cloze_transfer","target_ids":["ur-rank-0944"]},{"answer_id":"a10","id":"q10","prompt":"مہرین کے مطابق مؤثر غور کے دو حصے کیا ہیں؟","type":"summary","target_ids":["ur-rank-0961"]}],"reader_tags":["unit_role:transfer","generation_batch","a2"],"review_lexical_targets":[{"id":"ur-rank-0695","form":"مقصد","review_stage":"R1","representation":"running_text"}],"revision":1,"sentence_count":11,"sequence":28,"speed_training":{"benchmark_eligible":false,"comprehension_gate":0.8,"new_word_policy":"controlled","notes":"A2 generation-stage passage; formal fluency/coverage decision deferred to final audit.","timed":false},"text":"مہرین کو تاریخ کا مطالعہ پسند تھا، مگر پہلے وہ جو بھی مضمون سامنے آتا پڑھ لیتی اور بعد میں بہت سی باتیں بھول جاتی۔ یونیورسٹی میں اس نے اپنے پڑھنے کے طریقے پر غور کیا اور ایک نیا معمول بنایا۔ اب وہ مطالعہ شروع کرنے سے پہلے عنوان اور ذیلی عنوان دیکھتی ہے اور سوچتی ہے کہ اسے کس سوال کا جواب تلاش کرنا ہے۔ پڑھتے وقت وہ ہر صفحے پر نشان نہیں لگاتی؛ صرف وہ جملے نوٹ کرتی ہے جو اس سوال سے متعلق ہوں۔ ایک باب مکمل ہونے کے بعد وہ کتاب بند کر کے دو منٹ غور کرتی ہے کہ اہم خیال کیا تھا اور کون سی بات ابھی واضح نہیں۔ پھر وہ اپنے الفاظ میں تین یا چار جملے لکھتی ہے۔ اس طریقے سے مطالعہ تھوڑا آہستہ ہوا، لیکن یاد زیادہ رہنے لگی۔ ایک دوست نے پوچھا کہ کیا ہر کتاب کو اسی طرح پڑھنا ضروری ہے۔ مہرین نے کہا کہ نہیں؛ کہانی یا تفریح کے لیے پڑھتے وقت وہ اتنے نوٹ نہیں بناتی۔ گہرا مطالعہ تب مفید ہے جب کسی موضوع کو سمجھنا یا بعد میں استعمال کرنا ہو۔ اس کے نزدیک غور کا مطلب صرف دیر تک سوچنا نہیں، بلکہ یہ دیکھنا بھی ہے کہ کون سی بات سمجھی گئی اور کس حصے پر دوبارہ توجہ چاہیے۔","title":"مطالعہ پر غور","topics":["reading","study skills","reflection"],"unit":5,"word_count":214}