check":"pending","status":"draft"},"questions":[{"answer_id":"a1","id":"q1","prompt":"اس اطلاع کا بنیادی مقصد کیا ہے؟","type":"gist"},{"answer_id":"a2","id":"q2","prompt":"زیادہ تر غیر استعمال شدہ چیزوں کی واپسی کتنے دن کے اندر ہو سکتی ہے؟","type":"literal_detail"},{"answer_id":"a3","id":"q3","prompt":"اگر چیز خراب ہو تو خریدار سے کیا کرنے کو کہا گیا ہے؟","type":"literal_detail"},{"answer_id":"a4","id":"q4","prompt":"قیمت کی تصویر یا رسید ساتھ لانے سے کیا فائدہ ہے؟","type":"inference"},{"answer_id":"a5","id":"q5","prompt":"عبارت میں «واپسی» سے کیا مراد ہے؟","target_ids":["ur-rank-0800"],"type":"vocabulary_in_context"},{"answer_id":"a6","id":"q6","prompt":"«غیر ضروری تکلیف کم ہوتی ہے» میں «تکلیف» کا کیا مطلب ہے؟","target_ids":["ur-rank-0803"],"type":"vocabulary_in_context"},{"answer_id":"a7","id":"q7","prompt":"جملہ مکمل کریں: اگر رسید میں اختلاف _____ تو تصویر ساتھ لائیں۔","type":"grammar_choice"},{"answer_id":"a8","id":"q8","prompt":"«اس سے رقم کی جانچ میں غیر ضروری تکلیف کم ہوتی ہے» میں «اس» کس عمل کی طرف اشارہ کرتا ہے؟","type":"reference_resolution"},{"answer_id":"a9","id":"q9","prompt":"خالی جگہ پُر کریں: خریدی ہوئی چیز دکان کو واپس دینے کے عمل کو _____ کہتے ہیں۔","target_ids":["ur-rank-0800"],"type":"cloze_transfer"},{"answer_id":"a10","id":"q10","prompt":"اگر بڑی چیز واپس لے جانا مشکل ہو تو اطلاع کے مطابق پہلے کیا کرنا چاہیے؟","target_ids":["ur-rank-0803"],"type":"paraphrase"}],"reader_tags":["unit_role:interleaved","generation_batch","a2"],"review_lexical_targets":[{"form":"خراب","id":"ur-rank-0690","representation":"running_text","review_stage":"R1"},{"form":"اختلاف","id":"ur-rank-0769","representation":"running_text","review_stage":"R1"},{"form":"مخصوص","id":"ur-rank-0765","representation":"running_text","review_stage":"R1"},{"form":"اطلاع","id":"ur-rank-0901","representation":"running_text","review_stage":"R2"}],"revision":1,"sentence_count":10,"sequence":21,"speed_training":{"benchmark_eligible":false,"comprehension_gate":0.8,"new_word_policy":"controlled","notes":"A2 generation-stage passage; formal fluency/coverage decision deferred to final audit.","timed":false},"text":"اہم اطلاع: ہماری مرکزی دکان میں خریدی گئی زیادہ تر غیر استعمال شدہ چیزوں کی واپسی خریداری کے چودہ دن کے اندر کی جا سکتی ہے۔ واپسی کے وقت اصل رسید یا قابلِ تصدیق ڈیجیٹل رسید دکھانا ضروری ہے۔ اگر چیز خراب ہو تو براہِ کرم خرابی واضح طور پر بتائیں تاکہ عملے کو مسئلہ سمجھنے میں تکلیف نہ ہو۔ کھلی ہوئی ذاتی استعمال کی چند اشیا کی واپسی قبول نہیں کی جاتی؛ ان مخصوص اشیا کی فہرست معلوماتی میز پر موجود ہے۔ اگر رسید میں قیمت اور شیلف کی قیمت میں اختلاف ہو تو دونوں قیمتوں کی تصویر یا رسید ساتھ لائیں۔ اس سے رقم کی جانچ میں غیر ضروری تکلیف کم ہوتی ہے۔ مصروف اوقات میں واپسی کے کاؤنٹر پر انتظار زیادہ ہو سکتا ہے، اس لیے ممکن ہو تو صبح گیارہ بجے سے پہلے آئیں۔ اگر آپ کو چلنے پھرنے میں تکلیف ہو یا بڑی چیز لانا مشکل ہو تو پہلے فون پر اطلاع دیں؛ عملہ مناسب مدد کا انتظام کرے گا۔ ہماری کوشش ہے کہ واپسی کا طریقہ واضح رہے اور خریدار کو بار بار ایک ہی معلومات دینے کی تکلیف نہ ہو۔ مزید سوال کے لیے رسید پر دیا گیا رابطہ نمبر استعمال کریں۔","title":"واپسی اور مدد کی اطلاع","topics":["return policy","customer help","problem prevention"],"unit":4,"word_count":199}