se-learning","role":"review","description":"کیونکہ for explaining a learning choice"}],"id":"ur-a2-u05-p01","language":"ur","new_lexical_targets":[{"beyond_base":false,"context_strategy":["scenario_resolution"],"exposures_in_text":4,"first_introduced":true,"form":"شوق","id":"ur-rank-0833","intended_sense":"interest; hobby; enthusiasm","lemma":"شوق","part_of_speech":"noun","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":833,"variety":"contemporary standard Urdu"},{"beyond_base":false,"context_strategy":["scenario_resolution"],"exposures_in_text":4,"first_introduced":true,"form":"صلاحیت","id":"ur-rank-0807","intended_sense":"ability; capability; capacity to do something","lemma":"صلاحیت","part_of_speech":"noun","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":807,"variety":"contemporary standard Urdu"}],"paired_text_group":null,"passage_type":"instructional","prerequisites":["Urdu A1 generation corpus","Urdu A2 Units 1-4"],"quality":{"answer_key_check":"pending","coverage_check":"pending","fact_check":"not_required","linguistic_review":"pending","notes":["High-quality Urdu A2 generation-stage draft; formal linguistic, pedagogical, lexical-coverage, answer-key, and schema audits are deferred to the designated final multi-pass review phase.","Written independently in contemporary standard Urdu for the A2 hobbies-and-learning-skills roadmap; not translated from the Arabic or French corpora.","The deliberate learner-facing senses introduced in this unit were independently checked against the project Urdu lexicon and external dictionary evidence on 2026-08-24; persistent bounded evidence is stored in reading/audit/urdu_a2_u05_lexical_sense_check_2026-08-24.json.","Pre-canonical Urdu A2 Unit 5 reader-first quality pass completed 2026-08-24 for naturalness, target-sense clarity, answer grounding, operational grammar, and fluency new-word policy; formal release gates remain pending."],"pedagogical_review":"pending","schema_check":"pending","status":"draft"},"questions":[{"answer_id":"a1","id":"q1","prompt":"سعد کے خاکہ بنانے کے شوق میں کیا تبدیلی آئی؟","type":"gist"},{"answer_id":"a2","id":"q2","prompt":"سعد نے ہر ہفتے خاکہ بنانے کے لیے کتنا وقت مقرر کیا؟","type":"literal_detail"},{"answer_id":"a3","id":"q3","prompt":"«اس میں مشاہدہ کرنے کی اچھی صلاحیت ہے» میں «اس» کس کی طرف اشارہ کرتا ہے؟","type":"reference_resolution"},{"answer_id":"a4","id":"q4","prompt":"سعد اپنی پرانی تصویریں کیوں محفوظ رکھتا تھا؟","type":"inference"},{"answer_id":"a5","id":"q5","prompt":"عبارت میں «شوق» سے کیا مراد ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0833"]},{"answer_id":"a6","id":"q6","prompt":"«مشاہدہ کرنے کی صلاحیت» میں «صلاحیت» کا کیا مطلب ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0807"]},{"answer_id":"a7","id":"q7","prompt":"جملہ مکمل کریں: سعد دوسروں سے مقابلہ کرنے کے بجائے اپنے پچھلے کام _____ موازنہ کرتا ہے۔","type":"grammar_choice"},{"answer_id":"a8","id":"q8","prompt":"درست ربط چنیں: ہاتھ بنانا مشکل تھا، _____ سعد نے مشق جاری رکھی۔","type":"grammar_choice"},{"answer_id":"a9","id":"q9","prompt":"خالی جگہ پُر کریں: فوٹو کھینچنا مریم کا پسندیدہ _____ ہے۔","type":"cloze_transfer","target_ids":["ur-rank-0833"]},{"answer_id":"a10","id":"q10","prompt":"سعد کے تجربے کے مطابق کسی صلاحیت کو بہتر کرنے کے دو عملی طریقے کیا ہیں؟","type":"summary","target_ids":["ur-rank-0807"]}],"reader_tags":["unit_role:instructional","generation_batch","a2"],"review_lexical_targets":[{"id":"ur-rank-0665","form":"مشہور","review_stage":"R2","representation":"running_text"}],"revision":1,"sentence_count":10,"sequence":25,"speed_training":{"benchmark_eligible":false,"comprehension_gate":0.8,"new_word_policy":"controlled","notes":"A2 generation-stage passage; formal fluency/coverage decision deferred to final audit.","timed":false},"text":"سعد کو بچپن سے چیزوں کی تصویریں بنانے کا شوق تھا، لیکن وہ اسے صرف وقت گزارنے کا طریقہ سمجھتا تھا۔ کالج میں ایک دن اس نے دوستوں کے چہرے جلدی جلدی بنائے تو ایک ساتھی نے کہا کہ اس میں مشاہدہ کرنے کی اچھی صلاحیت ہے۔ سعد نے پہلی بار سوچا کہ شوق کے ساتھ صلاحیت بھی بڑھائی جا سکتی ہے۔ اس نے ہر ہفتے دو شامیں خاکہ بنانے کے لیے مقرر کیں اور مختلف چیزیں سامنے رکھ کر ان کی شکل، روشنی اور سایہ دیکھنے لگا۔ شروع میں ہاتھ اور آنکھیں بنانا مشکل تھا، مگر وہ اپنی پرانی تصویریں محفوظ رکھتا تاکہ تبدیلی دیکھ سکے۔ چند مہینوں بعد اس نے کالج کی چھوٹی نمائش میں تین خاکے رکھے۔ اسے انعام نہیں ملا، لیکن ایک استاد نے بتایا کہ اس کی سب سے بڑی صلاحیت چھوٹی تفصیل کو جلد پہچاننا ہے۔ سعد نے فیصلہ کیا کہ وہ اب بھی اسے شوق ہی رکھے گا، کیونکہ اسے اس کام سے خوشی ملتی ہے۔ تاہم اس نے یہ بھی سمجھا کہ کسی شوق میں باقاعدہ مشق کرنے سے موجود صلاحیت واضح اور مضبوط ہو سکتی ہے۔ اب وہ دوسروں سے مقابلہ کرنے کے بجائے اپنے پچھلے کام سے موازنہ کرتا ہے اور ہر نئے خاکے میں ایک چیز بہتر کرنے کی کوشش کرتا ہے۔","title":"خاکے بنانے کا شوق","topics":["drawing","hobby","ability"],"unit":5,"word_count":213}