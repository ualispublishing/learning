y","role":"new"},{"description":"کیونکہ / اس لیے for travel cause and response","id":"ur-a2-travel-cause","role":"review"}],"id":"ur-a2-u06-p01","language":"ur","new_lexical_targets":[{"beyond_base":false,"context_strategy":["temporal_context"],"exposures_in_text":5,"first_introduced":true,"form":"آمد","id":"ur-rank-0828","intended_sense":"arrival; coming or reaching a place","lemma":"آمد","part_of_speech":"noun","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":828,"variety":"contemporary standard Urdu"},{"beyond_base":false,"context_strategy":["travel_condition"],"exposures_in_text":5,"first_introduced":true,"form":"رفتار","id":"ur-rank-0843","intended_sense":"speed; pace of movement","lemma":"رفتار","part_of_speech":"noun","register":"contemporary standard","source_lexicon":"urdu_top1000.csv","source_rank":843,"variety":"contemporary standard Urdu"}],"paired_text_group":null,"passage_type":"instructional","prerequisites":["Urdu A1 generation corpus","Urdu A2 Units 1-5"],"quality":{"answer_key_check":"pending","coverage_check":"pending","fact_check":"not_required","linguistic_review":"pending","notes":["High-quality Urdu A2 generation-stage draft; formal linguistic, pedagogical, lexical-coverage, answer-key, and schema audits are deferred to the designated final multi-pass review phase.","Written independently in contemporary standard Urdu for the A2 transport-and-travel roadmap; not translated from the Arabic or French corpora.","The deliberate learner-facing senses introduced in this unit were independently checked against the project Urdu lexicon and external dictionary evidence on 2026-08-24; persistent bounded evidence is stored in reading/audit/urdu_a2_u06_lexical_sense_check_2026-08-24.json.","Pre-canonical Urdu A2 Unit 6 reader-first quality pass completed 2026-08-24 for naturalness, target-sense clarity, answer grounding, operational grammar, and fluency new-word policy; formal release gates remain pending."],"pedagogical_review":"pending","schema_check":"pending","status":"draft"},"questions":[{"answer_id":"a1","id":"q1","prompt":"زینب کے سفر میں بنیادی تبدیلی کیا ہوئی؟","type":"gist"},{"answer_id":"a2","id":"q2","prompt":"زینب نے ٹکٹ پر کون سے دو وقت پہلے دیکھے تھے؟","type":"literal_detail"},{"answer_id":"a3","id":"q3","prompt":"رفتار کم ہونے کے بعد زینب نے کیا کیا؟","type":"sequence"},{"answer_id":"a4","id":"q4","prompt":"زینب نے خالہ کو نیا وقت کیوں بتایا؟","type":"inference"},{"answer_id":"a5","id":"q5","prompt":"عبارت میں «آمد» سے کیا مراد ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0828"]},{"answer_id":"a6","id":"q6","prompt":"«ٹرین کی رفتار کم ہو گئی» میں «رفتار» کا کیا مطلب ہے؟","type":"vocabulary_in_context","target_ids":["ur-rank-0843"]},{"answer_id":"a7","id":"q7","prompt":"جملہ مکمل کریں: اگر رفتار کم رہے _____ آمد میں دیر ہو سکتی ہے۔","type":"grammar_choice"},{"answer_id":"a8","id":"q8","prompt":"«عملے نے نیا اندازہ بتایا» میں «نیا اندازہ» کس چیز کے بارے میں تھا؟","type":"reference_resolution"},{"answer_id":"a9","id":"q9","prompt":"خالی جگہ پُر کریں: ہماری بس کی _____ شام چھ بجے متوقع ہے۔","type":"cloze_transfer","target_ids":["ur-rank-0828"]},{"answer_id":"a10","id":"q10","prompt":"زینب کے تجربے سے سفر کے دوران کن دو چیزوں پر نظر رکھنا مفید ہے؟","type":"summary"}],"reader_tags":["unit_role:instructional","generation_batch","a2"],"review_lexical_targets":[{"form":"منصوبہ","id":"ur-rank-0751","representation":"running_text","review_stage":"R2"}],"revision":1,"sentence_count":12,"sequence":31,"speed_training":{"benchmark_eligible":false,"comprehension_gate":0.8,"new_word_policy":"controlled","notes":"A2 generation-stage passage; formal fluency/coverage decision deferred to final audit.","timed":false},"text":"زینب نے پہلی بار اکیلے ٹرین سے دوسرے شہر جانے کا منصوبہ بنایا۔ اس نے ٹکٹ پر روانگی اور آمد کا وقت پہلے ہی دیکھ لیا تھا، کیونکہ وہاں پہنچ کر اسے اپنے خالہ کے گھر جانا تھا۔ صبح ٹرین وقت پر چلی، لیکن شہر سے باہر نکلتے ہی بارش شروع ہو گئی۔ کچھ دیر بعد گاڑی کی رفتار کم ہو گئی اور اعلان ہوا کہ آگے پٹری کے ایک حصے پر کام جاری ہے۔ زینب نے گھڑی دیکھی اور سوچا کہ اگر رفتار اسی طرح کم رہی تو آمد میں دیر ہو سکتی ہے۔ اس نے خالہ کو پیغام بھیجا کہ ممکن ہے وہ مقررہ وقت سے بیس منٹ بعد پہنچے۔ راستے میں بارش کم ہوئی تو ٹرین کی رفتار دوبارہ معمول پر آ گئی۔ عملے نے نیا اندازہ بتایا کہ آمد صرف دس منٹ دیر سے ہوگی۔ زینب نے اپنے سامان کو دروازے کے قریب نہیں رکھا بلکہ نشست کے پاس محفوظ رکھا تاکہ اترتے وقت جلدی نہ کرنی پڑے۔ اسٹیشن کے قریب پہنچتے ہوئے ٹرین پھر آہستہ ہوئی، کیونکہ شہر کے اندر رفتار محدود تھی۔ آخرکار زینب کی آمد تقریباً اعلان کیے گئے نئے وقت پر ہوئی۔ اسے سمجھ آیا کہ سفر میں صرف ٹکٹ دیکھنا کافی نہیں؛ آمد کے وقت اور رفتار میں تبدیلی پر نظر رکھنا بھی مفید ہے۔","title":"بارش میں ٹرین کا سفر","topics":["train travel","arrival","speed"],"unit":6,"word_count":214}