    "A2": ["explicit detail", "cause/reason", "reference chain", "word inference", "paraphrase", "cloze transfer"],
    "B1": ["main idea", "motive", "inference", "summary", "paraphrase", "cloze/transfer"],
    "B2": ["claim/evidence", "stance", "implication", "compare viewpoints", "lexical nuance", "transfer"],
    "C1": ["rhetorical function", "assumption", "implicit stance", "synthesis", "register", "evidence evaluation"],
    "C2": ["argument reconstruction", "implicature/irony", "rhetorical critique", "multiple plausible interpretations", "multi-source synthesis", "precision reformulation"]
