{
  "version": 1,
  "purpose": "Planning inventory for Arabic, French, and Urdu graded reading passages. Targets guide exposure and comprehension tasks; they are not CEFR certification claims.",
  "shared_progression": {
    "A1": {
      "grammar_functions": ["simple affirmative clauses", "basic negation", "yes-no questions", "basic wh-questions", "pronouns and reference", "basic possession", "present/time-now expressions", "simple coordination with and/but/or", "basic place and direction phrases"],
      "discourse": ["single clear topic", "local sentence-to-sentence reference", "simple chronological order", "explicit contrast", "explicit cause or result", "restatement/paraphrase", "concrete inference from nearby context"]
    },
    "A2": {
      "grammar_functions": ["past and future reference", "modality and ability", "comparatives", "basic relative clauses", "object reference", "subordination with because/when/if", "simple commands and requests", "frequency and duration"],
      "discourse": ["short narrative chains", "problem-solution", "cause-effect across sentences", "basic paragraphing", "pronoun/reference chains", "simple viewpoint", "summary of explicit main idea"]
    },
    "B1": {
      "grammar_functions": ["wider tense-aspect contrasts", "conditionals", "reported information", "passive or impersonal constructions", "expanded relative clauses", "clause chaining", "degree and qualification", "basic hypothetical language"],
      "discourse": ["multi-paragraph cohesion", "motive and reason inference", "main idea versus supporting detail", "sequence with flashback or comparison", "stance markers", "paraphrase across clauses", "summary and near transfer"]
    },
    "B2": {
      "grammar_functions": ["complex subordination", "concession", "advanced modality and hedging", "nominalization", "participial/non-finite compression where natural", "reported speech and attribution", "passive/impersonal variation", "counterfactual and nuanced condition"],
      "discourse": ["argument and counterargument", "evidence versus claim", "implicit causal links", "paired viewpoints", "cohesive reference over distance", "author stance", "distinguishing fact, inference, and opinion"]
    },
    "C1": {
      "grammar_functions": ["dense clause embedding", "register-sensitive modality", "advanced information structure", "ellipsis and substitution where natural", "rhetorical parallelism", "complex nominal style", "fine-grained tense/aspect choice", "controlled stylistic variation"],
      "discourse": ["implicit stance", "assumption identification", "rhetorical function", "synthesis across sections", "qualified claims", "genre conventions", "subtle cohesion", "controlled ambiguity and inference"]
    },
    "C2": {
      "grammar_functions": ["full range of standard grammar", "idiomatic and figurative constructions", "marked information structure", "register shifts", "compressed professional/academic syntax", "literary syntactic variation", "scope ambiguity when purposeful", "rhetorical manipulation of syntax"],
      "discourse": ["reconstructing complex argument", "irony and implicature", "intertextual or allusive meaning when supported", "multi-source synthesis", "rhetorical critique", "fine register distinctions", "competing interpretations", "evaluating evidence and hidden premises"]
    }
  },
  "language_specific": {
