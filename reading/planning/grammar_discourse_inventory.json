      "B1": ["verb-form families in context", "more varied negation", "relative and subordinate clauses", "active/passive contrasts", "masdar constructions", "agreement with non-human plurals"],
      "B2": ["concessive and causal connectors", "participles and verbal nouns", "complex idafa/nominal structures", "reported discourse", "formal impersonal/passive style"],
      "C1_C2": ["register-sensitive connectors", "rhetorical parallelism", "dense nominalization", "fine modality", "classical/literary echoes only when clearly labeled and pedagogically justified"]
