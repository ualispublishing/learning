{
  "version": 1,
  "purpose": "Ensure cumulative lexical recycling across varied topics and genres without overusing one scenario. Units are parallel in pedagogical function across languages but passages are independently written, not translations.",
  "unit_cycle_roles": [
    {"sequence": 1, "role": "instructional", "function": "introduce a small number of inferable lexical/grammar targets in a highly coherent context"},
    {"sequence": 2, "role": "reinforcement", "function": "near-spaced retrieval with the same theme but a new situation"},
    {"sequence": 3, "role": "interleaved", "function": "mix new targets with older confusable or related material"},
    {"sequence": 4, "role": "transfer", "function": "reuse targets after a larger contextual shift in topic, speaker, or genre"},
    {"sequence": 5, "role": "integration", "function": "combine old and new targets in a more demanding comprehension task"},
    {"sequence": 6, "role": "fluency_checkpoint", "function": "high-coverage passage with little/no new vocabulary; comprehension gates speed progress"}
  ],
  "levels": {
    "A1": [
      {"unit": 1, "theme": "people, place, and daily orientation", "genres": ["micro-story", "dialogue-like narrative", "simple description"], "domains": ["self", "home", "neighborhood"]},
      {"unit": 2, "theme": "daily routine and time", "genres": ["routine narrative", "schedule", "short message"], "domains": ["daily life", "time"]},
      {"unit": 3, "theme": "food and simple choices", "genres": ["market/cafe scene", "description", "short exchange"], "domains": ["food", "shopping"]},
      {"unit": 4, "theme": "family and friends", "genres": ["profile", "micro-story", "message"], "domains": ["relationships"]},
      {"unit": 5, "theme": "school and basic work", "genres": ["day-in-the-life", "notice", "simple explanation"], "domains": ["education", "work"]},
      {"unit": 6, "theme": "directions and local travel", "genres": ["route description", "micro-story", "instruction"], "domains": ["transport", "places"]},
      {"unit": 7, "theme": "weather, clothes, and plans", "genres": ["forecast-like note", "story", "message"], "domains": ["weather", "daily life"]},
      {"unit": 8, "theme": "health and basic needs", "genres": ["problem-solution story", "advice note", "description"], "domains": ["health"]},
      {"unit": 9, "theme": "leisure and simple preferences", "genres": ["profile", "invitation", "micro-story"], "domains": ["hobbies", "social life"]},
      {"unit": 10, "theme": "A1 cumulative mixed life", "genres": ["connected story", "mixed notices/messages", "checkpoint"], "domains": ["mixed"]}
