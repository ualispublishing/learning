{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CISSP Atlas Candidate Question",
  "type": "object",
  "required": [
    "id", "format", "stem", "domain_primary", "domains_secondary", "objectives", "subtopics",
    "difficulty_tier", "difficulty_score", "scenario_family", "decision_point", "decision_verb",
    "correct_rule_id", "knowledge_atoms", "misconceptions", "source_ids", "originality"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "format": {"enum": ["mcq", "bellringer"]},
    "stem": {"type": "string", "minLength": 20},
    "domain_primary": {"type": "integer", "minimum": 1, "maximum": 8},
    "domains_secondary": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 8}, "uniqueItems": true},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "subtopics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "difficulty_tier": {"enum": ["F", "E", "S", "B"]},
    "difficulty_score": {"type": "integer", "minimum": 35, "maximum": 100},
    "scenario_family": {"type": "string", "minLength": 2},
    "decision_point": {"type": "string", "minLength": 2},
    "decision_verb": {"type": "string", "minLength": 2},
    "correct_rule_id": {"type": "string", "minLength": 2},
    "knowledge_atoms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "misconceptions": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "originality": {
      "type": "object",
      "required": ["origin", "no_external_question_seed", "sibling_of"],
      "properties": {
        "origin": {"const": "original-from-public-scope"},
        "no_external_question_seed": {"const": true},
        "sibling_of": {"type": ["string", "null"]},
        "authoring_note": {"type": "string"}
      },
      "additionalProperties": true
    },
    "options": {"type": "array", "items": {"type": "string"}},
    "answer": {"type": "integer", "minimum": 0, "maximum": 3},
    "explanation": {"type": "string"},
    "distractor_rationales": {"type": "array", "items": {"type": "string"}},
    "prompts": {"type": "array", "items": {"type": "string"}},
    "rubric": {"type": ["array", "object"]}
  },
  "allOf": [
    {
      "if": {"properties": {"format": {"const": "mcq"}}},
      "then": {
        "required": ["options", "answer", "explanation", "distractor_rationales"],
        "properties": {
          "options": {"minItems": 4, "maxItems": 4},
          "distractor_rationales": {"minItems": 4, "maxItems": 4}
        }
      }
    },
    {
      "if": {"properties": {"format": {"const": "bellringer"}}},
      "then": {
        "required": ["prompts", "rubric"],
        "properties": {
          "difficulty_tier": {"const": "B"},
          "prompts": {"minItems": 4, "maxItems": 8},
          "knowledge_atoms": {"minItems": 8}
        }
      }
    }
  ],
  "additionalProperties": true
}
